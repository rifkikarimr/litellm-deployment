# Provider credentials. Replace locally; never commit real values.
OPENAI_API_KEY=replace-me
GEMINI_API_KEY=replace-me

# Provider-qualified LiteLLM model identifiers.
PRIMARY_MODEL=openai/gpt-5.6-luna
FALLBACK_MODEL=gemini/gemini-3.7-flash

# LiteLLM authentication and persistence.
LITELLM_MASTER_KEY=replace-me
LITELLM_SALT_KEY=replace-me
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://litellm:replace-me@postgres:5432/litellm

# Host interface and port exposed by Docker Compose. Keep loopback unless a
# firewall and TLS-enabled reverse proxy protect network access.
LITELLM_BIND_ADDRESS=127.0.0.1
LITELLM_PORT=4000

# Optional Langfuse/OpenTelemetry integration. Leave unset for core operation.
# LITELLM_OTEL_V2=true
# LANGFUSE_PUBLIC_KEY=replace-me
# LANGFUSE_SECRET_KEY=replace-me
# LANGFUSE_HOST=https://cloud.langfuse.com
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=no_content
